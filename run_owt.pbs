#!/bin/bash
#PBS -N bpe_owt
#PBS -l select=1:ncpus=128:mem=440G
#PBS -l walltime=8:00:00
#PBS -j oe
#PBS -o owt_out.log
#PBS -P personal-xuanhe00
#PBS -q normal

cd $PBS_O_WORKDIR
export PATH="$HOME/.local/bin:$PATH"
module load miniforge3

uv run python -c "
import time, pickle
from cs336_basics.train_bpe import TokenizerTrainer

t0 = time.time()
trainer = TokenizerTrainer(
    input_path='data/owt_train.txt',
    vocab_size=32000,
    special_tokens=['<|endoftext|>'],
    num_processes=128,
)
vocab, merges = trainer.train_bpe()
elapsed = time.time() - t0

pickle.dump(vocab, open('out/owt/vocab.pkl', 'wb'))
pickle.dump(merges, open('out/owt/merges.pkl', 'wb'))

longest_id, longest_bytes = max(vocab.items(), key=lambda kv: len(kv[1]))
print(f'耗时 {elapsed:.1f}s（约 {elapsed/3600:.2f} 小时）')
print(f'词表大小 {len(vocab)}, merges数 {len(merges)}')
print(f'最长token: {longest_bytes!r}')
"
